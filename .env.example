# Copy to .env (cp .env.example .env). .env is not committed.

# local PostGIS container (docker compose up -d); a throwaway password, local only
POSTGRES_DB=iris
POSTGRES_USER=iris
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5434

# used by the harvester and the tests
DATABASE_URL=postgresql://iris:change-me@localhost:5434/iris

# sent to the portal in the User-Agent header so its operator can reach you: use your own address
HARVESTER_CONTACT=your.name@example.com
